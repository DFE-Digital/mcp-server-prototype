{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureSearch": {
    "Endpoint": "https://<your-resource>.search.windows.net",
    "ApiKey": "<your-query-key>",
    "Indexes": {
      "Ofsted": "",
      "Establishments": "",
      "RecastConcerns": "",
      "RiseConcerns": ""
    }
  },
  "McpServer": {
    "Name": "RSD_MCP_Server",
    "Title": "RSD MCP Server",
    "Version": "1.0.0",
    "Description": "Handles multiple data sources",
    "IsStateless": true,
    "Endpoint": "/mcp",
    "HealthCheckEndpoint": "/health"
  },
  "PromptFiles": {
    "SystemPrompts": {
      "McpGovernance": "Prompts/MCP_Governance_System_Prompt_Addendum.md"
    }
  },
  "RestrictedPaths": {
    "ServerPath": "C:\\Users\\restricted_server_path"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "ClientId": "<client_id>",
    "TenantId": "<tenant_id>",
    "Audience": "<Audience>"
  },
  "ServerBaseUrl": "https://localhost:7146",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:6274",
      "https://localhost:7146"
    ]
  },
  "ConnectionStrings": {
    "AcademiesConnection": ""
  },
  "Databricks": {
    "WorkspaceUrl": "https://adb-xxxxxxxxxxxxxxxx.xx",
    "WarehouseId": "12345",
    "AccessToken": null,
    "WaitTimeOut": "0s"
  },
  "SharePoint": {
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "SiteHostname": "contoso.sharepoint.com",
    "SitePath": "/sites/"
  }
}

