{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureSearch": {
    "Endpoint": "https://<your-resource>.search.windows.net",
    "ApiKey": "<your-query-key>",
    "Indexes": {
      "Ofsted": "",
      "Establishment": ""
    }
  },
  "McpServer": {
    "Name": "RSD_MCP_Server",
    "Title": "RSD MCP Server",
    "Version": "1.0.0",
    "Description": "Handles multiple data sources",
    "IsStateless": true,
    "Endpoint": "/mcp",
    "HealthCheckEndpoint": "/health"
  },
  "PromptOptions": {
    "Files": {
      "SystemInstruction": "Prompts/SystemInstruction.txt",
      "Ofsted": "Prompts/Ofsted.txt",
      "Concern": "Prompts/Concern.txt"
    }
  },
  "RestrictedPaths": {
    "ServerPath": "C:\\Users\\restricted_server_path"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "ClientId": "<client_id>",
    "TenantId": "<tenant_id>",
    "Audience": "<Audience>"
  },
  "ServerBaseUrl": "https://localhost:7146",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:6274",
      "https://localhost:7146"
    ]
  }
}

